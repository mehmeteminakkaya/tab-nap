{
  "manifest_version": 3,
  "name": "Tab Nap: Snooze Tabs",
  "short_name": "Tab Nap",
  "version": "1.0.0",
  "description": "Snooze tabs until later. Close a tab now and it comes back this evening, tomorrow, at the weekend or whenever you choose.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Snooze this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "tabs", "notifications", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Tab Nap"
    }
  }
}
